{
  "name": "@harmonic-field/core",
  "version": "0.1.0",
  "description": "Stochastic harmonic potential field generator for music composition",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "musiclab": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "vitest run --reporter=verbose --include 'test/visual/**/*.test.ts'",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "cli": "tsx src/cli/index.ts",
    "example:basic": "tsx examples/generate-basic-progression.ts",
    "example:folk": "tsx examples/generate-folk-progression.ts",
    "example:debug": "tsx examples/debug-potential-field.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@xmldom/xmldom": "^0.9.10",
    "eslint": "^9.0.0",
    "fast-check": "^3.22.0",
    "prettier": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
